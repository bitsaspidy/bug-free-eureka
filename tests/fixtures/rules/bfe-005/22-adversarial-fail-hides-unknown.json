{
  "name": "adversarial-fail-hides-unknown",
  "description": "one failing logger outranks unknowns",
  "overrides": {
    "loggers": [
      {
        "library": "pino-http",
        "kind": "request",
        "scope": "global",
        "location": "src/a.ts:1",
        "emits": {
          "requestHeaders": "yes",
          "responseHeaders": "no",
          "requestBody": "no",
          "query": "no"
        },
        "redaction": {
          "state": "unresolved"
        }
      },
      {
        "library": "pino-http",
        "kind": "request",
        "scope": "global",
        "location": "src/b.ts:2",
        "emits": {
          "requestHeaders": "yes",
          "responseHeaders": "no",
          "requestBody": "no",
          "query": "no"
        },
        "redaction": {
          "state": "none"
        }
      }
    ]
  },
  "expected": {
    "status": "fail",
    "confidence": "high"
  }
}
