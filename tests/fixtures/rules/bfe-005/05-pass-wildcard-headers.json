{
  "name": "pass-wildcard-headers",
  "description": "req.headers.* removes every header",
  "overrides": {
    "loggers": [
      {
        "library": "pino-http",
        "kind": "request",
        "scope": "global",
        "location": "src/app.ts:12",
        "emits": {
          "requestHeaders": "yes",
          "responseHeaders": "no",
          "requestBody": "no",
          "query": "no"
        },
        "redaction": {
          "state": "paths",
          "paths": ["req.headers.*"]
        }
      }
    ]
  },
  "expected": {
    "status": "pass",
    "confidence": "high"
  }
}
