{
  "name": "bug-free-eureka",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source API security and configuration toolkit for Node.js (workspace root).",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "npm@11.15.0",
  "scripts": {
    "build": "npm run build -w @bug-free-eureka/core && npm run build -w @bug-free-eureka/express && npm run build -w @bug-free-eureka/cli",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
