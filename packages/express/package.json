{
  "name": "@bug-free-eureka/express",
  "version": "0.0.0",
  "description": "Express adapter for Bug-Free Eureka.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsaspidy/bug-free-eureka.git",
    "directory": "packages/express"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22 <27"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  }
}
